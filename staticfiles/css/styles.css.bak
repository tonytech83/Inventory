@import url("https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap");

:root {
  /* main */
  --background-color: #373737;
  --primary-color: #acbabf;
  --secondary-color: #6c757d;
  --text-color: #c0c0c2;
  --text-error: #ff0000;
  /* other */
  --text-color: #000000;
  --bg-color: #282828;
  /* buttons */
  --create-border: #198754;
  --create-border-hover: #157347;
  --cancel-border: #ffc107;
  --cancel-border-hover: #ffca2e;
  --download-border: #f8f9fa;
  --download-border-hover: #d3d4d5;
  --delete-border: #dc3545;
  --delete-border-hover: #bb2d3b;
  --edit-border: #0d6efd;
  --edit-border-hover: #0a58ca;
  /* table */
  --background: #000;
  --color: #fff;
  --table-border-color: #444;
  --table-header-background: #262626;
  --table-header-color: #fff;
  --background-color-row-odd: #0d0d0d;
  --background-color-row-even: #0d0d0d;
  --background-color-row-first: #0d0d0d;
  --cell-color: #0d0d0d;
  --cell-selected-color: #222;
  --ctx-background: #111;
  --ctx-background-hover: #222;
  --scroll-track: #111;
  --scroll-thumb: #575757;
  --scroll-thumb-hover: #575757;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body {
  height: 100%;
  margin: 0;
  background: darkgrey;
  font-family: "Montserrat", sans-serif;
}

.site-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.content {
  flex: 1;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

/* ===============================================================
=== HOME
================================================================== */
.home-wrapper {
  display: flex;
  flex-direction: row;

  gap: 40px;
}

.business-stats {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 2px solid var(--background-color);
  padding: 20px;
  height: 88vh;
}

.business-stats .title-container {
  text-align: center;
  margin: 0;
}

#catalogue {
  width: 80%;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.owned,
.other {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

@media (max-height: 1080px) {
  .business-stats .title-container h3 {
    font-size: 18px;
  }

  .business-stats h5 {
    font-size: 16px;
  }

  .business-stats .box {
    height: 180px;
    width: 230px;
  }
}

/* ===============================================================
=== NAV
================================================================== */
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 2%;
  background: var(--background-color);
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
}

.link-item,
.link-item-link {
  font-weight: 500;
  font-size: 22px;
  color: var(--text-color);
  text-decoration: none;
}

.logo {
  height: 60px;
  width: 60px;
  background: transparent;
  color: var(--text-color);
}

.nav-links {
  list-style: none;
  margin: 0;
}

.nav-links li {
  display: inline-block;
  padding: 0 20px;
}

.nav-links li a {
  transition: all 0.3s ease 0s;
}

.nav-links li:hover {
  background: coral;
  transition: all 0.3s ease 0s;
}

/*Menu for Profile*/
.profile-image {
  display: inline-block;
  height: 40px;
  width: 40px;
  text-align: center;
  /*padding: 4px 8px 4px 7px;*/
  border-radius: 50%;
}

.dropdown {
  text-decoration: none;
  display: inline-block;
  background: var(--background-color);
  color: black;
}

.initials {
  display: inline-block;
  background: var(--primary-color);
  color: var(--background-color);
  width: 40px;
  font-size: 24px;
  font-weight: 600;
  margin: auto;
  padding: 4px 2px;
}

.dropdown-menu {
  color: black;
}

.dropdown-toggle::after {
  content: none;
}

.dropdown-item {
  font-size: 16px;
}

.nav-group .nav-item .dropdown-menu .dropdown-item {
  font-size: 16px;
  color: black;
}

[data-bs-theme="dark"] {
  --bs-body-color: var(--background-color);
  --bs-body-color-rgb: #{to-rgb($white)};
  --bs-body-bg: var(--text-color);
  --bs-body-bg-rgb: #{to-rgb($blue)};
  --bs-tertiary-bg: #{$blue-600};

  .dropdown {
    --bs-dropdown-bg: #{mix($blue-500, $blue-600)};
    --bs-dropdown-link-active-bg: #{$blue-700};
  }

  .btn-secondary {
    --bs-btn-bg: #{mix($gray-600, $blue-400, 0.5)};
    --bs-btn-border-color: #{rgba($white, 0.25)};
    --bs-btn-hover-bg: #{darken(mix($gray-600, $blue-400, 0.5), 5%)};
    --bs-btn-hover-border-color: #{rgba($white, 0.25)};
    --bs-btn-active-bg: #{darken(mix($gray-600, $blue-400, 0.5), 10%)};
    --bs-btn-active-border-color: #{rgba($white, 0.5)};
    --bs-btn-focus-border-color: #{rgba($white, 0.5)};
    --bs-btn-focus-box-shadow: 0 0 0 0.25rem rgba(255, 255, 255, 0.2);
  }
}

@media (max-height: 1080px) {
  .link-item,
  .link-item-link {
    font-size: 18px;
  }

  .logo {
    height: 40px;
    width: 40px;
  }

  .initials {
    width: 30px;
    height: 30px;
    font-size: 18px;
  }
}
/* ===============================================================
=== BUSINESS CARD
================================================================== */
.business-card {
  position: relative;
  display: flex;
  justify-content: center; /* Aligns horizontally */
  align-items: center; /* Aligns vertically */
  flex-direction: column;
  font-weight: bold;
  width: 200px;
  height: 200px;
  padding: 20px 20px;

  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;

  background: var(--background-color);
  color: var(--text-color);
  cursor: pointer;
}

.create-business {
  background: green;
}

.business-card:hover {
  background: lightgray;
  color: var(--background-color);
  transition: background 0.3s;
  /* Shake animation */
  animation: shake 0.82s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  transform: translate3d(0, 0, 0);
  backface-visibility: hidden;
  perspective: 1000px;
}

/* Shake animation */
@keyframes shake {
  10%,
  90% {
    transform: translate3d(-1px, 0, 0);
  }

  20%,
  80% {
    transform: translate3d(2px, 0, 0);
  }

  30%,
  50%,
  70% {
    transform: translate3d(-2px, 0, 0);
  }

  40%,
  60% {
    transform: translate3d(2px, 0, 0);
  }
}

.business-icon {
  position: absolute;
  top: 20px;
  left: 20px;
}

.fa-industry {
  font-size: 2em;
  font-weight: 900;
  color: coral;
}

.business-link {
  font-size: 1.5em;
  margin: 0;
}

.hidden {
  position: absolute;
  bottom: 20px;
  right: 20px;
}

.red {
  color: red;
}

.plus {
  margin: 0;
  font-size: 4em;
}

@media (max-height: 1080px) {
  .business-card {
    width: 180px;
    height: 180px;
    padding: 15px 15px;
  }

  .create-business {
    background: green;
  }

  .business-link {
    font-size: 1.2em;
  }
}

/* ===============================================================
=== DEVICE
================================================================== *
#deviceCreateForm,
#deviceEditForm {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.device-info,
.support-info,
.risk-info {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

.input-group-sm {
    flex-basis: 32%;
}

.date-field {
    flex-basis: 32%;
    margin-right: 1.5em;
}

#existingInvoiceLink {
    flex-basis: 32%;
    margin-bottom: 1em;
}

.sub-title {
    display: inline-block;
    width: 100%;
    font-size: 1.2em;
}

/* color for Hostname ans Serial Number fields */
.important {
  color: red !important;
}

#errorsContainer,
#errorsEditContainer,
#errorsEditBusinessContainer {
  width: 100%;
  text-align: center;
  color: red;
}

@media (max-height: 1080px) {
  #deviceCreateForm .input-group,
  #deviceEditForm .input-group {
    font-size: 14px !important;
    margin-bottom: 8px !important;
  }

  #deviceCreateForm .input-group-text,
  #deviceEditForm .input-group-text {
    padding: 2px 4px;
  }

  #deviceEditForm .action-title,
  #deviceCreateForm .action-title {
    font-size: 20px;
  }

  #deviceEditForm .sub-title,
  #deviceCreateForm .sub-title {
    font-size: 16px;
  }
}

/* ===============================================================
=== PROFILE
================================================================== */
.profile-container .wrapper {
  width: 90%;
  margin: auto;
  display: flex;
  gap: 30px;
  justify-content: center;
  align-items: center;
}

.profile-container .wrapper .profile-image {
  width: 30%;
  height: 100%;
}

.profile-container .wrapper .profile-image img {
  border: 2px solid var(--background-color);
  width: 100%;
  height: 100%;
}

.profile-information {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 70%;
  text-align: left;
}

.profile-information .profile-item {
  border: 2px solid var(--background-color);
  padding-left: 10px;
  display: inline-block;
  width: 49%;
  text-align: left;
}

.buttons-container {
  margin: auto;
  width: 50%;
  text-align: center;
}

/* ===============================================================
=== STATS
================================================================== */
.stats {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
}

h5 {
  text-align: center;
  margin-bottom: 20px;
  border: 2px solid;
  width: 100%;
}

.box {
  height: 230px;
  width: 260px;

  display: flex;
  flex-direction: column;
  align-items: center;

  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
  background: var(--background-color);
  padding: 10px;
  color: var(--text-color);
}

.total-devices:hover,
.not-reviewed:hover {
  background: lightgray;
  color: var(--background-color);
  transition: background 0.3s;
  animation: shake 0.82s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  transform: translate3d(0, 0, 0);
  backface-visibility: hidden;
  perspective: 1000px;
  cursor: pointer;
}

.box .total-devices-count {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: auto;
}

.table-location {
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: left;
  width: 100%;
  height: 100%;
  /*border: 2px solid;*/
  padding: 5px;
}

.table-location table {
  border-collapse: collapse; /* Optional: for styling */
  margin: 0 auto; /* Center the table horizontally if flexbox doesn't apply */
}

.table-location table tr td {
  border-bottom: 2px solid transparent;
}

.box a {
  text-decoration: none;
}

/* Styling for links in boxes*/
.box .selected {
  width: 100%;
  padding: 1px 2px;
  background: var(--text-color);
  color: coral;
}

.box .not-selected {
  padding: 1px 2px;
  color: var(--text-color);
}

.box .not-selected:hover {
  padding: 1px 2px;
  color: coral;
}

table {
  width: 100%;
}

@media (max-height: 1080px) {
  .box {
    height: 200px;
    width: 230px;
  }

  .box h5 {
    font-size: 18px;
    margin-bottom: 10px;
  }

  .box td {
    font-size: 14px;
  }
}

/* ===============================================================
=== BUTTONS
================================================================== */
.reset-button-style {
  border: none;
  margin: 0;
  padding: 0;
  width: auto;
  overflow: visible;
  background: transparent;

  /* inherit font & color from ancestor */
  color: inherit;
  font: inherit;

  /* Normalize `line-height`. Cannot be changed from `normal` in Firefox 4+. */
  line-height: normal;
}

.button-container {
  width: 100%;
  padding: 0 10px; /* Keep your padding */
  box-sizing: border-box; /* This ensures padding is included in the width */
  display: flex;
  justify-content: space-between;
  border: 2px solid var(--background-color); /* Example border */
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
}

.control-buttons {
  display: flex;
  gap: 5px;
}

.action-buttons {
  display: flex;
  gap: 5px;
}

.button {
  background: var(--background-color);
  text-decoration: none;
  padding: 0 12px;
  margin: 6px 0;
  font-size: 1em;
}

.btn-create {
  background: var(--create-border);
  border: 2px solid var(--create-border);
  transition: border-color 0.3s;
  color: var(--text-color);
  font-weight: bold;
}

.btn-create:hover {
  background: var(--create-border-hover);
}

.btn-cancel {
  border: 2px solid transparent;
  transition: border-color 0.3s;
  background: darkgrey;
  color: var(--background-color);
  font-weight: bold;
}

.btn-cancel:hover {
  border: 2px solid var(--cancel-border-hover);
}

.btn-download {
  border: 2px solid transparent;
  transition: border-color 0.3s;
  background: darkgrey;
  color: var(--background-color);
  font-weight: bold;
}

.btn-download:hover {
  border: 2px solid var(--download-border);
}

.btn-delete {
  border: 2px solid transparent;
  transition: border-color 0.3s;
  background: darkgrey;
  color: var(--background-color);
  font-weight: bold;
}

.btn-delete:hover {
  border: 2px solid var(--delete-border-hover);
}

.btn-edit {
  border: 2px solid transparent;
  transition: border-color 0.3s;
  background: darkgrey;
  color: var(--background-color);
  font-weight: bold;
}

.btn-edit:hover {
  border: 2px solid var(--edit-border-hover);
}

@media (max-height: 1080px) {
  .button {
    font-size: 0.9em;
  }
}

/* ===============================================================
=== BUSINESS
================================================================== */
.business-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 20px;
  align-items: center;
  justify-content: space-between;
}

/* ===============================================================
=== TABLE
================================================================== */
#data-container {
  font-family: "Montserrat", sans-serif;
  font-size: 1.5em;
  border: 3px solid var(--table-border-color);
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
  width: 100%;
}

#data-container .handsontable {
  font-size: 1em;
  font-weight: normal;
  /*color: var(--color);*/
  color: var(--text-color);
}

#data-container .handsontable .wtHolder {
  background-color: var(--table-header-background);
}

/* All headers */
#data-container .handsontable th {
  background-color: var(--table-header-background);
  color: var(--table-header-color);
}

/* Row headers */
#data-container .ht_clone_left th {
  background-color: var(--table-header-background);
  color: var(--table-header-color);
}

/* Column headers */
#data-container .ht_clone_top th {
  background-color: var(--table-header-background);
  color: var(--text-color);
  font-size: 1.1em;
}

/* Row headers */
#data-container .ht_clone_top_left_corner th {
  border-bottom: 1px solid var(--table-border-color);
}

#data-container .ht_clone_left th {
  border-right: 1px solid var(--table-border-color);
  border-left: 1px solid var(--table-border-color);
}

/* Column headers */
#data-container .ht_clone_top th {
  border-top: 1px solid var(--table-border-color);
  border-right: 1px solid var(--table-border-color);
  border-bottom: 1px solid var(--table-border-color);
}

#data-container .ht_clone_top_left_corner th {
  border-right: 1px solid var(--table-border-color);
}

#data-container .handsontable .changeType {
  background: coral;
  border-color: var(--table-border-color);
}

/* Borders */
#data-container .handsontable th,
#data-container .handsontable td {
  border-right: 1px solid var(--table-border-color);
  border-bottom: 1px solid var(--table-border-color);
}

#data-container .handsontable tr:first-child td,
#data-container .handsontable tr:first-child th {
  border-top: 1px solid var(--table-border-color);
}

#data-container .ht_master tr > td {
  border-bottom: 1px solid var(--table-border-color);
}

/* Right */
#data-container .ht_master tr > td {
  border-right: 1px solid var(--table-border-color);
}

#data-container #data-container .handsontable .htNoFrame + td,
#data-container .handsontable .htNoFrame + th,
#data-container .handsontable.htRowHeaders thead tr th:nth-child(2),
#data-container .handsontable td:first-of-type,
#data-container .handsontable th:first-child,
#data-container .handsontable th:nth-child(2) {
  border-left: 1px solid var(--table-border-color);
}

#data-container .ht_clone_top_left_corner thead tr th:nth-last-child(2) {
  border-right: 1px solid var(--table-border-color);
}

#data-container .handsontable th:last-child {
  border-right: 1px solid var(--table-border-color);
  border-bottom: 1px solid var(--table-border-color);
}

/* Selected cell */
#data-container tr > td {
  background-color: var(--background-color);
}

/* Selected cell */
#data-container tr > td.current {
  background-color: var(--cell-selected-color);
}

/* Context menu */
.htContextMenu tr,
.htDropdownMenu tr,
.htFiltersConditionsMenu tr {
  background-color: var(--ctx-background);
}

.htContextMenu table tbody tr td,
.htDropdownMenu table tbody tr td,
.htFiltersConditionsMenu table tbody tr td {
  background-color: var(--text-color);
}

.htContextMenu table tbody tr td.current,
.htContextMenu table tbody tr td.zeroclipboard-is-hover,
.htDropdownMenu table tbody tr td.current,
.htDropdownMenu table tbody tr td.zeroclipboard-is-hover,
.htFiltersConditionsMenu table tbody tr td.current,
.htFiltersConditionsMenu table tbody tr td.zeroclipboard-is-hover {
  background-color: var(--ctx-background-hover);
}

.htContextMenu .handsontable table td.htCustomMenuRenderer,
.htDropdownMenu .handsontable table td.htCustomMenuRenderer {
  background-color: var(--background-color);
}

.handsontable .htUISelectCaption,
.handsontable .htUISelectCaption:hover {
  background-color: var(--ctx-background);
}

/* Scroll bar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--scroll-track);
}

::-webkit-scrollbar-thumb {
  background: var(--scroll-thumb);
}

::-webkit-scrollbar-thumb:hover {
  background: var(--scroll-thumb-hover);
}

/*==================================*/

.handsontable .htUIClearAll a,
.handsontable .htUISelectAll a {
  font-size: 1em;
}

.handsontable .htFiltersMenuCondition .htUIInput input,
.handsontable .htFiltersMenuValue .htUIMultipleSelectSearch input {
  font-size: 1em;
}

.handsontable .htFiltersMenuLabel {
  color: var(--text-color);
}

.handsontable a {
  color: coral;
}

.handsontable span.colHeader {
  font-size: 0.6em;
  font-weight: bold;
  /*color: var(--background-color);*/
}

.handsontable .htDimmed {
  color: var(--text-color);
  font-size: 0.6em;
}

.handsontable .htDimmed:nth-child(1) {
  color: coral;
  font-weight: 500;
  font-size: 0.6em;
  cursor: pointer;
}

@media (max-height: 1080px) {
  #data-container {
    height: 59vh !important;
  }

  .suppliers-container #data-container {
    height: auto !important;
  }
}

/* ===============================================================
=== FORMS
================================================================== */
/* Backdrop styles */
.backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: none;
  z-index: 10;
}

.nojs {
  display: block;
}

/* Bigger Edit and Save form for devices */
#editForm,
#createForm,
#deleteForm,
#uploadCSVForm {
  width: 80%;
  height: 60%;

  position: fixed; /* Position relative to the viewport */
  top: 50%; /* Center vertically */
  left: 50%; /* Center horizontally */
  transform: translate(-50%, -50%); /* Adjust the centering */
  z-index: 1000; /* Above the backdrop */
  background-color: darkgrey; /* Ensure the form is visible against the backdrop */
  padding: 20px; /* Add some padding */
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Optional: Adds a subtle shadow */
  display: none;
}

/* Smaller Edit, Create, Login, Register and etc. forms */
.login-page,
.register-page,
.profile-container,
.edit-profile,
.password-change,
.password_done,
#createBusinessForm,
#createSupplierForm,
#editSupplierForm,
#deleteSupplierForm,
#businessEditFormContainer,
#deleteDeviceForm,
.organization-create,
.organization-edit,
.report-edit {
  width: 50%;
  height: 40%;

  position: fixed; /* Position relative to the viewport */
  top: 50%; /* Center vertically */
  left: 50%; /* Center horizontally */
  transform: translate(-50%, -50%); /* Adjust the centering */
  z-index: 1000; /* Above the backdrop */
  background-color: darkgrey; /* Ensure the form is visible against the backdrop */
  padding: 20px; /* Add some padding */
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Optional: Adds a subtle shadow */
}

.login-form,
.signup-form,
.business-create-form,
.business-edit-form,
.device-create-form,
.device-edit-form,
.device-delite-form,
.profile-details-form,
.profile-edit-form,
.password-change-form,
.password-done-form,
.organization-edit-form,
.organization-create-form,
.organization-create-form-done,
.supplier-create-form,
.supplier-edit-form,
.supplier-delete-form,
.report-edit-form {
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.inputs {
  width: 70%;
  margin: auto;
}

/* Tables in Dashboard */
#tableOne,
#tableTwo,
#tableThree {
  width: 80%;
  height: 28%;

  position: fixed; /* Position relative to the viewport */
  top: 50%; /* Center vertically */
  left: 50%; /* Center horizontally */
  transform: translate(-50%, -50%); /* Adjust the centering */
  z-index: 1000; /* Above the backdrop */
  background-color: darkgrey; /* Ensure the form is visible against the backdrop */
  padding: 20px; /* Add some padding */
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Optional: Adds a subtle shadow */
  display: none; /* Hidden by default */
}

.title-container {
  width: 100%;
  border: 2px solid var(--background-color);
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
  margin-bottom: 20px;
}

.title-container h4,
.title-container h3 {
  text-align: center;
  line-height: 1;
  margin: 6px 0;
}

/* Error*/
.error-messages {
  display: flex;
  justify-content: center;
}

.error-messages .error {
  text-align: center;
  color: var(--text-error);
  font-size: 0.9em;
}

.pass_done {
  text-align: center;
  margin-top: 25%;
}

#errorsSupplierContainer,
#errorsSupplierEditContainer,
#errorsDeleteConfirmContainer {
  position: absolute;
  bottom: 12%;
  color: red;
  font-size: 0.9rem;
  text-align: left;
  margin: auto;
}

#errorsSupplierContainer p,
#errorsSupplierEditContainer p,
#errorsDeleteConfirmContainer p {
  padding: 0;
  margin: 0;
}

#inputGroup-sizing-sm {
  color: black;
  font-weight: 500;
}

@media (max-height: 1080px) {
  #editForm,
  #createForm {
    width: 80%;
    height: 70%;
  }

  .login-page,
  .register-page,
  .profile-container,
  .edit-profile,
  .password-change,
  .password_done,
  #createBusinessForm,
  #createSupplierForm,
  #editSupplierForm,
  #deleteSupplierForm,
  #businessEditFormContainer,
  #deleteDeviceForm,
  .organization-create,
  .organization-edit {
    width: 40%;
    height: 40%;

    position: fixed; /* Position relative to the viewport */
    top: 50%; /* Center vertically */
    left: 50%; /* Center horizontally */
    transform: translate(-50%, -50%); /* Adjust the centering */
    z-index: 1000; /* Above the backdrop */
    background-color: darkgrey; /* Ensure the form is visible against the backdrop */
    padding: 20px; /* Add some padding */
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Optional: Adds a subtle shadow */
  }

  .inputs .input-group-text {
    font-size: 14px !important;
    padding: 3px 10px !important;
  }

  .inputs .form-control {
    font-size: 14px !important;
    padding: 3px 10px !important;
  }

  .login-form h3,
  .register-page h3 {
    font-size: 20px;
  }

  .title-container {
    margin-bottom: 15px;
  }

  .title-container h4 {
    font-size: 20px;
  }

  .title-container h3 {
    font-size: 22px;
  }
}

/* ===============================================================
=== FOOTER
================================================================== */
.footer {
  text-align: center;
  background: var(--background-color);
  padding: 10px 0;
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
  color: var(--text-color);
}

@media (max-height: 1080px) {
  .footer {
    padding: 5px 0;
    font-size: 16px;
  }
}

/* ===============================================================
=== DASHBOARD
================================================================== */
/* ---------------------
  Dashboard not logged in
------------------------ */
.dashboard-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  text-align: center;
  width: auto;
  justify-content: space-between;
  padding: 5% 0;
}

.mySlides {
  width: 100%;
  display: none;
  border: 2px solid var(--background-color);
  padding: 20px 40px;
  background: lightgrey;
}

.w3-left,
.w3-right,
.w3-badge {
  cursor: pointer;
}

.w3-badge {
  height: 13px;
  width: 13px;
  padding: 0;
}

/* ---------------------
        Table
------------------------ */
.dashboard-table {
  border: 2px solid var(--background-color);
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
  width: 100%;
  height: 100%;
  font-size: 0.9em;
  margin: auto;
}

.dashboard-table th {
  border-right: 2px solid var(--background-color);
  border-left: 2px solid var(--background-color);
  text-align: center;
}

.dashboard-table th:last-child,
.dashboard-table td:last-child,
.totals {
  background: var(--background-color);
  color: var(--text-color);
}

.dashboard-table tr {
  border: 2px solid var(--background-color);
}

.dashboard-table td {
  border-right: 2px solid var(--background-color);
  font-weight: 500;
  text-align: center;
}

.dashboard-table .business-name {
  padding-left: 5px;
  text-align: start;
}

/*---------------------------
        Chart
-----------------------------*/
.pie-carts {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}

.bar-chart {
  margin-top: 30px;
  padding: 10px;
  border: 2px solid var(--background-color);
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
}

.chart-legend {
  padding: 5px 25px;
  border: 2px solid var(--background-color);
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.chart-legend:hover {
  background: lightgray;
  color: var(--background-color);
  transition: background 0.3s;
  /* Shake animation */
  animation: shake 0.82s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  transform: translate3d(0, 0, 0);
  backface-visibility: hidden;
  perspective: 1000px;
}

#chart_one,
#chart_two,
#chart_three {
  width: 350px !important;
  height: 350px !important;
  display: block;
  box-sizing: border-box;
  gap: 20px;
}

#bar {
  height: 630px !important;
}

/* Shake animation */
@keyframes shake {
  10%,
  90% {
    transform: translate3d(-1px, 0, 0);
  }

  20%,
  80% {
    transform: translate3d(2px, 0, 0);
  }

  30%,
  50%,
  70% {
    transform: translate3d(-2px, 0, 0);
  }

  40%,
  60% {
    transform: translate3d(2px, 0, 0);
  }
}

#legend_one,
#legend_two,
#legend_three {
  margin: auto;
  font-size: 0.77em;
  font-weight: 500;
}

.legend-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  display: inline-block;
  margin-right: 3px;
}

@media (max-height: 1080px) {
  .dashboard-container {
    margin: auto;
    width: 60%;
  }

  .container .w3-container h1 {
    font-size: 24px;
  }

  .container .w3-container h1 {
    font-size: 24px;
  }

  .container .w3-container h4,
  .start-using {
    font-size: 18px;
  }

  .mySlides {
    width: 100%;
    display: none;
    border: 2px solid var(--background-color);
    padding: 20px 40px;
    background: lightgrey;
  }
}

@media (max-height: 1080px) {
  .pie-carts {
    justify-content: space-between;

    gap: 20px;
  }

  .chart-legend {
    width: 28%;
    height: 25%;
  }

  #bar {
    height: 500px !important;
  }

  .bar-chart {
    margin-top: 15px;
  }

  #chart_one,
  #chart_two,
  #chart_three {
    width: 250px !important;
    height: 250px !important;
    display: block;
    box-sizing: border-box;
    gap: 15px;
  }

  .dashboard-table {
    height: auto;
    font-size: 0.8em;
  }
}

/* ===============================================================
=== UPLOAD
================================================================== */
.upload-wrapper {
  display: flex;
  justify-content: space-between;
  flex-direction: column;
  height: 100%;
}

#uploadDescription {
  margin: auto;
}

#importResults {
  display: none;
  overflow-y: auto;
  width: 80%;
  height: 80%;
  margin: 5% 10% 10% 10%;
}

#uploadMessage {
  color: red;
  display: none;
  margin: auto;
}

/* ===============================================================
=== SUPPLIERS
================================================================== */
.suppliers-container {
  height: 84vh;
  /*height: 100%;*/
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cards-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.supplier-card {
  position: relative;
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
  background: var(--background-color);
  color: var(--text-color);
  cursor: pointer;
  padding: 20px;
  width: 300px;
}

.supplier-card:hover {
  background: lightgray;
  color: var(--background-color);
  transition: background 0.3s;
  /* Shake animation */
  animation: shake 0.82s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  transform: translate3d(0, 0, 0);
  backface-visibility: hidden;
  perspective: 1000px;
}

/* Shake animation */
@keyframes shake {
  10%,
  90% {
    transform: translate3d(-1px, 0, 0);
  }

  20%,
  80% {
    transform: translate3d(2px, 0, 0);
  }

  30%,
  50%,
  70% {
    transform: translate3d(-2px, 0, 0);
  }

  40%,
  60% {
    transform: translate3d(2px, 0, 0);
  }
}

.card-title {
  font-size: 20px;
  margin-bottom: 15px;
}

.supplier-message {
  text-align: center;
}

/* Searchbar */
.search-bar {
  position: relative;
  width: 20%;
  margin-right: auto;
  display: flex;
  align-items: center;
  border: 2px solid var(--background-color);
  box-shadow: rgba(0, 0, 0, 0.35) 0 5px 15px;
  margin-bottom: 20px;
  transition: width 0.5s ease-in-out;
}

.search-bar:hover {
  width: 100%;
}

.search-bar input {
  width: 100%;
  padding: 6px 0 6px 12px;
  border: none;
}

.search-button {
  position: absolute;
  right: 10px;
}

@media (max-height: 1080px) {
  .supplier-card {
    display: flex;
    flex-direction: column;
    width: 220px;
    height: 220px;
    padding: 10px;
    justify-content: space-between;
  }

  .supplier-card p {
    margin-bottom: 8px;
    font-size: 14px;
  }
}

/* ===============================================================
=== SYSTEM MESSAGES
================================================================== */
.forbidden,
.not-found {
  display: flex;
  flex-direction: column;
  height: 100%;
  margin: auto;
  text-align: center;
}
